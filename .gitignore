*.apk
*.aab
*.ipa
*.app
*.exe
*.msi
*.bundle

# ------------------------------------------------------------
# 6. TRỌNG SỐ MÔ HÌNH AI & CHECKPOINTS (DUNG LƯỢNG LỚN)
# ------------------------------------------------------------
# Không đẩy file weights binary lớn lên Git
models/**/*.safetensors
models/**/*.pt
models/**/*.pth
models/**/*.bin
models/**/*.onnx
models/**/*.ckpt
models/**/*.h5
models/**/*.tflite

# Giữ cấu trúc thư mục models bằng .gitkeep (mọi file khác trong models/ đều bị chặn)
models/**
!models/**/
!models/**/.gitkeep

# HuggingFace & Torch Cache
.cache/
hf_cache/
torch_cache/

# ------------------------------------------------------------
# 7. NHẬT KÝ HUẤN LUYỆN & THEO DÕI THÍ NGHIỆM
# ------------------------------------------------------------
training/logs/*
!training/logs/.gitkeep
wandb/
runs/
events.out.tfevents.*
checkpoints/
mlruns/
mlflow/
lightning_logs/
tensorboard/
logs/

# ------------------------------------------------------------
# 8. KHO LƯU TRỮ TỆP DI SẢN (STORAGE)
# ------------------------------------------------------------
# File âm thanh gốc và đã phục chế lưu trữ local/server
# Mọi file trong storage/ đều private — chỉ giữ cây thư mục bằng .gitkeep
storage/**
!storage/**/
!storage/**/.gitkeep

# ------------------------------------------------------------
# 9. TẬP DỮ LIỆU ÂM THANH (DATASETS)
# ------------------------------------------------------------
# Dataset gốc, đã tiền xử lý, metadata và annotation đều KHÔNG upload
# Chỉ giữ cây thư mục bằng .gitkeep
datasets/**
!datasets/**/
!datasets/**/.gitkeep

