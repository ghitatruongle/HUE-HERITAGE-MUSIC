APP_NAME=Hue Heritage Music API
# Mac dinh: <repo>/hue_heritage.db. Chi ghi DATABASE_URL khi can CSDL khac;
# duong dan tuyet doi dang: sqlite:///E:/duong/dan/toi/db.sqlite
# DATABASE_URL=sqlite:///duong/dan/tuyet/doi
SECRET_KEY=change-me-to-a-long-random-string
AUTH_REQUIRED=true
TOKEN_TTL_HOURS=72
ADMIN_TOKEN_TTL_HOURS=8
ADMIN_UNLOCK_WINDOW_SECONDS=600
AUTH_FLOOD_IP_LIMIT=120
REGISTER_IP_RATE_LIMIT=200
# Tran that bai dang ky moi IP / 15 phut (chong oracle doan ma moi + spam)
REGISTER_FAILURE_IP_LIMIT=30
# Dev LAN/deploy that really needs it should keep "*"; when deploying publicly, list the exact origins (comma separated)
ALLOWED_ORIGINS=*
REDIS_URL=redis://127.0.0.1:6379/0
USE_RQ=false
ACESTEP_API_URL=http://127.0.0.1:8001
INVITE_CODES=
# So sinh nhạc chay dong thoi toi da (M4 nen de 1); task thu se xep hang "queued"
GENERATION_CONCURRENCY=1
# Gioi han so request POST nang (phan tich/sinh nhac/upload) moi IP moi phut
HEAVY_RATE_LIMIT=30
# So ngay giu task da xong truoc khi tu dong xoa (0 = tat); chay khi khoi dong server
TASK_RETENTION_DAYS=30
# So ngay giu file phat sinh truoc khi nut "Don dep" cua admin xoa (0 = giu vinh vien)
GENERATED_RETENTION_DAYS=14
PRACTICE_MIDI_RETENTION_DAYS=7
LESSON_CACHE_RETENTION_DAYS=30
# Toan bo cay storage/analysis (ngoai cache bai hoc co moc han rieng)
ANALYSIS_RETENTION_DAYS=30
# Nguong tu-dong shed 503+Retry-After khi so request dang xu ly vuot muc (0 = tat).
# Tang tras xu ly thuc te khoang 800 req/s tren SQLite 1 worker; 480 = du day du cho tran do.
SHED_CONCURRENCY=480
# Bat /docs, /redoc, /openapi.json (mac dinh tat, nen giu tat o production)
# ENABLE_DOCS=0
