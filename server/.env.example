APP_NAME=Hue Heritage Music API
# Mac dinh: <repo>/hue_heritage.db. Chi ghi DATABASE_URL khi can CSDL khac;
# duong dan tuyet doi dang: sqlite:///E:/duong/dan/toi/db.sqlite
# DATABASE_URL=sqlite:///duong/dan/tuyet/doi
SECRET_KEY=change-me-to-a-long-random-string
AUTH_REQUIRED=true
TOKEN_TTL_HOURS=72
ADMIN_TOKEN_TTL_HOURS=8
ADMIN_UNLOCK_WINDOW_SECONDS=600
AUTH_FLOOD_IP_LIMIT=120
# Mac dinh trong code = 20; 200 la gia tri khuyen nghi cho LAN deploy
REGISTER_IP_RATE_LIMIT=200
# Tran that bai dang ky moi IP / 15 phut (chong oracle doan ma moi + spam)
REGISTER_FAILURE_IP_LIMIT=30
# Dev LAN/deploy that really needs it should keep "*"; when deploying publicly, list the exact origins (comma separated)
ALLOWED_ORIGINS=*
REDIS_URL=redis://127.0.0.1:6379/0
USE_RQ=false
ACESTEP_API_URL=http://127.0.0.1:8001
INVITE_CODES=
# So sinh nhạc chay dong thoi toi da (M4 nen de 1); task thu se xep hang "queued"
GENERATION_CONCURRENCY=1
# Gioi han so request POST nang (phan tich/sinh nhac/upload) moi IP moi phut
HEAVY_RATE_LIMIT=30
# So ngay giu task da xong truoc khi tu dong xoa (0 = tat); chay khi khoi dong server
TASK_RETENTION_DAYS=30
# So ngay giu file phat sinh truoc khi nut "Don dep" cua admin xoa (0 = giu vinh vien)
GENERATED_RETENTION_DAYS=14
PRACTICE_MIDI_RETENTION_DAYS=7
LESSON_CACHE_RETENTION_DAYS=30
# Toan bo cay storage/analysis (ngoai cache bai hoc co moc han rieng)
ANALYSIS_RETENTION_DAYS=30
# Che do tach not phia ban mau (v2 = beta1: median-nang + delta-threshold; v1 = quay lai alpha2)
REFERENCE_SEGMENTATION=v2
# Nguong tu-dong shed 503+Retry-After khi so request dang xu ly vuot muc (0 = tat).
# Tang tras xu ly thuc te khoang 800 req/s tren SQLite 1 worker; 480 = du day du cho tran do.
SHED_CONCURRENCY=480
# Bat /docs, /redoc, /openapi.json (mac dinh tat, nen giu tat o production)
# ENABLE_DOCS=0
# Tai khoan admin truong duy nhat (mac dinh 'ghitatruongle' trong code — cam dat 'admin')
# ADMIN_TRUONG_USERNAME=ghitatruongle
# Duong dan vuot mac dinh (mac dinh: <repo>/storage, <repo>/models, <repo>/app/build/web)
# STORAGE_DIR=storage
# MODELS_DIR=models
# WEB_DIR=app/build/web

# Tuning theo cỡ server (mặc định hợp cho VPS 2-4 core / 4-8GB RAM)
# Server yếu (1-2 core): hạ UVICORN_LIMIT_CONCURRENCY=128, DB_POOL_SIZE=16, DB_MAX_OVERFLOW=32
# Server mạnh (8+ core): nâng DB_POOL_SIZE=96, DB_MAX_OVERFLOW=240
UVICORN_LIMIT_CONCURRENCY=512
# Do sau hang doi accept cua uvicorn (mac dinh 2048).
# LUU Y macOS: kernel cap kern.ipc.somaxconn=128 — backlog lon hon bi cắt xuống 128,
# bão tải lớn trên macOS vẫn có thể ra ConnectError phía client (đã đo ở bien-ban-kiem-dinh-0.0.1:
# --backlog 8192 không giúp gì trên macOS; Linux VPS không có cap này, nên tăng khi bão tải).
# LUU Y launchd: plist giữ --backlog 2048 cứng — đổi ProgramArguments của plist cần
# launchctl bootout + bootstrap lại (kickstart -k KHÔNG nạp args mới); nhánh deploy_lan.sh đọc env này.
# Vận hành shedding: khi quá tải server trả 503+Retry-After (SHED_CONCURRENCY), client nên retry sau 0.5-2s;
# đổi UVICORN_LIMIT_CONCURRENCY/SHED_CONCURRENCY theo cỡ server, không cần sửa code.
UVICORN_BACKLOG=2048
DB_POOL_SIZE=64
DB_MAX_OVERFLOW=160

# So ngay giu file phuc hoi (heritage/restored) truoc khi don dep (0 = giu vinh vien)
RESTORED_RETENTION_DAYS=30
# So ngay giu file MusicXML ky am (heritage/musicxml) truoc khi don dep (0 = giu vinh vien)
MUSICXML_RETENTION_DAYS=30
# Tran dung luong kho luu tru moi user thuong (MB, tinh tong file audio thuoc so huu user; 0 = tat; admin truong khong tran)
USER_STORAGE_QUOTA_MB=500
# So giua 2 lan don dep tu dong (retention + prune) khi server chay dai (0 = tat, chi don khi khoi dong / nut admin)
MAINTENANCE_INTERVAL_HOURS=6
# So thread worker toi da chay task DSP inline (transcribe/restore/instruments)
WORKER_THREADS=8
# Tran cho doi lock basic-pitch (giay); vuot se tra 503 "engine busy" thay vi treo vo han
BASIC_PITCH_LOCK_WAIT_TIMEOUT=90
# Tran thoi gian chay 1 lan basic-pitch predict (giay); vuot thi EngineStalled va 503 den khi thread ket thuc
BASIC_PITCH_RUN_TIMEOUT=600
# Nap model basic-pitch ngay khi khoi dong server (nen bat =1 tren server that de request dau khong cham)
BASIC_PITCH_WARMUP=0
# So task DSP nang dong thoi moi user moi loai (transcribe/compare/pitch/restore/instruments/evaluate)
HEAVY_INFLIGHT_PER_USER=2
# So ngay giu bao cao crash client gui len server truoc khi tu xoa (0 = giu vinh vien)
CRASH_REPORT_RETENTION_DAYS=30
